# Copy to .env and fill in what you need. .env is ignored by Git.
# Only the variables for the provider you select are required.

# --- OpenAI (--provider openai) ---
OPENAI_API_KEY=

# --- DeepSeek (--provider deepseek) ---
DEEPSEEK_API_KEY=

# --- Ollama (--provider ollama) ---
# Defaults to http://localhost:11434 when unset.
OLLAMA_BASE_URL=http://localhost:11434
# Only for an authenticated or hosted daemon; a local one needs no token.
# OLLAMA_API_KEY=

# --- Defaults, so you can run a bare `cargo run` ---
# RIGAGENT_PROVIDER=ollama
# RIGAGENT_MODEL=llama3.2
# RIGAGENT_SYSTEM_PROMPT=You are a terse terminal assistant.

# --- Optional MCP integration ---
# Path to an MCP server list; see mcp.example.json. Unset means no MCP.
# RIGAGENT_MCP_CONFIG=mcp.json

# --- Optional logging ---
# Logs go to this file only (never to the terminal, which the TUI owns).
# RIGAGENT_LOG_FILE=rigagent.log
# RUST_LOG=rigagent=debug

# Turn cap per message (model calls plus tool rounds); default 500.
# RIGAGENT_MAX_TURNS=500

# --- Optional skill library ---
# Directory of */SKILL.md documents; unset means no skills.
# RIGAGENT_SKILLS_DIR=/path/to/skills
