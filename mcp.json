{
  "servers": [
    {
      "name": "playwright",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--output-dir",
        ".playwright-output"
      ],
      "env": {},
      "enabled": true
    },
    {
      "name": "pally",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://agent.pally.com/mcp"
      ],
      "env": {},
      "enabled": true
    },
    {
      "name": "fs",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2.0.0",
        "/Users/cemguler/dev_env/rust_workspace/rigagent/src",
        "/Users/cemguler/dev_env/rust_workspace/rigagent/docs",
        "/Users/cemguler/dev_env/agent-workspace"
      ],
      "env": {},
      "enabled": true
    }
  ]
}
